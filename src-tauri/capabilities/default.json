{
  "identifier": "default",
  "description": "Default capability for AutoCompress",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "autostart:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit"
  ]
}
